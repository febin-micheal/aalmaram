.env
*.env
!.env.example
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
.DS_Store
*.sqlite3
media/
# The data-entry friction log. Contains real relatives' names by its nature; the
# committed template is NOTES.example.md.
NOTES.md
# Database dumps. Real family data lives here and must never reach a public repo.
# The directory itself is tracked (via .gitkeep) so Docker cannot create it root-owned.
backups/*
!backups/.gitkeep
# Production secrets and deploy state. None of this may ever be committed.
.env.production
.deploy.env
secrets/
*.age
*.gpg
age-identity*.txt
rclone.conf
# Cloud provider credentials and deploy run state. ~/.oci lives outside the repo, but a
# stray copy must never be committable either.
.oci/
oci_api_key*
*.pem
*.key
deploy/launch-attempts.log
deploy/*.env
staticfiles/
.pytest_cache/
.coverage
