# Production environment template.
#
# Copy to `.env.production` **on the VM only**. That file is gitignored and must never be
# committed, pasted into an issue, or copied back to a laptop. Every value below is a
# placeholder; none of them work.
#
#   cp .env.production.example .env.production && chmod 600 .env.production

# --- site ---------------------------------------------------------------------
SITE_DOMAIN=family.bulkbeing.in
ACME_EMAIL=you@example.com

DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Production refuses to start if this is empty.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=family.bulkbeing.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://family.bulkbeing.in

# --- database -----------------------------------------------------------------
# Postgres publishes no host port, so this password guards the compose network only —
# which is still no reason for it to be weak.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=aalmaram
POSTGRES_USER=aalmaram
POSTGRES_PASSWORD=

# --- backups ------------------------------------------------------------------
# age PUBLIC key (starts age1...). Only the public half lives here: the VM encrypts
# backups it cannot itself read. The private identity belongs in your password manager.
#   age-keygen -o age-identity.txt     # keep the identity OFF this machine
AGE_RECIPIENT=

# rclone remote and path. Configured in ./secrets/rclone.conf on the VM (0600).
#   rclone config   ->  n) new remote, name it b2, type: b2
RCLONE_REMOTE=b2:aalmaram-backups/prod

BACKUP_RETAIN_LOCAL=7
BACKUP_RETAIN_REMOTE=30
BACKUP_INTERVAL=86400

# --- host user ----------------------------------------------------------------
UID=1000
GID=1000
