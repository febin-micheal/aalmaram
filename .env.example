# Copy to .env for local development. Never commit a real .env.
# These values are development-only placeholders.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=aalmaram
POSTGRES_USER=aalmaram
POSTGRES_PASSWORD=aalmaram
POSTGRES_HOST=db
POSTGRES_PORT=5432

# The frontend calls the API same-origin through the Vite dev proxy, which is what lets
# the Django admin session cookie authenticate it. VITE_PROXY_TARGET is where Vite
# forwards those calls (the compose service name inside docker).
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://backend:8000

# The backend and frontend containers run as this uid/gid so that files they write into
# the bind mounts (migrations, package-lock.json) stay editable on the host. Only set
# these if `id -u` is not 1000.
# UID=1000
# GID=1000
